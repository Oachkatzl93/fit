Options -Indexes -MultiViews

<FilesMatch "^(config(?:\.example)?\.php|\..*|.*(?:~|\.bak|\.old|\.swp))$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^lib(?:/|$) - [F,END]
    RewriteRule ^mcp/([A-Za-z0-9_-]{32,})$ mcp.php?token=$1 [END]
</IfModule>
